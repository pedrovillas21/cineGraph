# Copie para .env.local e preencha com o arquivo de credenciais baixado ao criar
# a instância AuraDB Free em https://console.neo4j.io
# Sem estas variáveis a aplicação roda em modo demo com o grafo de exemplo.
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# TMDB (pôster, sinopse e título em pt-BR). Usado só pelo ETL, no terminal.
# themoviedb.org → Settings → API → "API Read Access Token" (começa com eyJ).
# Sem ele o ETL carrega o grafo normalmente, só sem os metadados.
TMDB_API_TOKEN=

# Opcional (Vercel): protege /api/cron/keepalive; a Vercel envia este valor no cabeçalho Authorization.
CRON_SECRET=
